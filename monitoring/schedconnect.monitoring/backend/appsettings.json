{
  "Prometheus": {
    "Url": "http://localhost:9090"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Monitoring": {
    "Thresholds": {
      "ResponseTimeWarningMs": 500,
      "ResponseTimeCriticalMs": 1000,
      "ErrorRateWarningPercent": 5,
      "ErrorRateCriticalPercent": 10,
      "CpuWarningPercent": 70,
      "CpuCriticalPercent": 90
    }
  },
  "AI": {
    "Model": "gpt-5-mini"
  }
}
