pipeline {
    agent any

    triggers {
        githubPush()
    }

    environment {
        DB_HOST     = credentials('AIVEN_DB_HOST')
        DB_PORT     = credentials('AIVEN_DB_PORT')
        DB_NAME     = credentials('AIVEN_DB_NAME')
        DB_USER     = credentials('AIVEN_DB_USER')
        DB_PASSWORD = credentials('AIVEN_DB_PASSWORD')
    }

    stages {

        stage('Check Docker access') {
            steps {
                sh 'docker version'
            }
        }

        stage('Build backend (DEV)') {
            steps {
                dir('backend') {
                    sh 'docker build -f Dockerfile.dev -t backend-ci .'
                }
            }
        }

        stage('Tests backend') {
            steps {
                sh '''
                docker run --rm \
                  -e ConnectionStrings__DefaultConnection="Server=$DB_HOST;Port=$DB_PORT;Database=$DB_NAME;User=$DB_USER;Password=$DB_PASSWORD;SslMode=Required;" \
                  backend-ci \
                  dotnet test
                '''
            }
        }

        stage('Build frontend (local check)') {
            steps {
                dir('frontend') {
                    sh 'docker build -t frontend-ci .'
                }
            }
        }

        stage('Deploy Backend to Render') {
            // when { branch 'main' }
            steps {
                withCredentials([string(credentialsId: 'RENDER_DEPLOY_HOOK_BACKEND', variable: 'HOOK')]) {
                    sh 'curl -X POST "$HOOK"'
                }
            }
        }

        stage('Deploy Frontend to Render') {
            // when { branch 'main' }
            steps {
                withCredentials([string(credentialsId: 'RENDER_DEPLOY_HOOK_FRONTEND', variable: 'HOOK')]) {
                    sh 'curl -X POST "$HOOK"'
                }
            }
        }
    }

    post {
        success {
            echo 'CI OK → Backend & Frontend déployés sur Render'
        }
        failure {
            echo 'CI échoué → Aucun déploiement Render'
        }
    }
}
